---
// Punto de integración: reemplaza la simulación enviando detecciones reales con
// window.dispatchEvent(new CustomEvent('detections', { detail: { cam: 'CAM-01', boxes: [{ x, y, w, h, label, conf }] } }))
// (coordenadas normalizadas 0–1). Para video real, pon un <video> o <img> MJPEG detrás del canvas.
const { cam, name, compact = false, online = true } = Astro.props;
---
<a href="/camaras" class:list={['feed', { compact }]} data-feed={cam} data-online={String(online)}>
  <canvas></canvas>
  <span class="tag"><span class:list={['dot', online ? 'live' : 'off']}></span> {cam} &nbsp;{name}</span>
  {!online && <span class="off">Sin señal. Revisa la conexión de la cámara.</span>}
</a>
<style>
  .feed { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: #0b1426; box-shadow: 0 20px 50px -20px rgba(30,45,90,.45); }
  .compact { border-radius: 16px; }
  canvas { width: 100%; height: 100%; display: block; }
  .tag { position: absolute; left: .8rem; top: .8rem; display: flex; align-items: center; gap: .45rem; padding: .35rem .7rem; border-radius: 999px; font-size: .75rem; font-weight: 700; background: rgba(9,15,30,.55); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  .compact .tag { font-size: .66rem; left: .5rem; top: .5rem; padding: .25rem .55rem; }
  .off { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 1rem; font-size: .85rem; color: rgba(255,255,255,.65); }
  .tag { color: #fff; }
</style>
<script>
  type Box = { x: number; y: number; w: number; h: number; label: string; conf: number };
  const LABELS = ['Arma de fuego', 'Cuchillo', 'Rostro cubierto', 'Mochila abandonada'];
  const real = new Map<string, Box[]>();
  window.addEventListener('detections', (e) => {
    const { cam, boxes } = (e as CustomEvent).detail;
    real.set(cam, boxes);
  });

  document.querySelectorAll<HTMLElement>('[data-feed]').forEach((el, n) => {
    if (el.dataset.online === 'false') return;
    const cam = el.dataset.feed!;
    const cv = el.querySelector('canvas')!;
    const ctx = cv.getContext('2d')!;
    const sim = Array.from({ length: 1 + (n % 2) }, (_, i) => ({
      x: 0.2 + Math.random() * 0.5, y: 0.3 + Math.random() * 0.3, w: 0.13, h: 0.26,
      vx: (Math.random() - 0.5) * 0.0006, vy: (Math.random() - 0.5) * 0.0004,
      label: LABELS[(n + i) % LABELS.length], conf: 0.8 + Math.random() * 0.15,
    }));
    const resize = () => { const r = el.getBoundingClientRect(); const d = devicePixelRatio || 1; cv.width = r.width * d; cv.height = r.height * d; };
    new ResizeObserver(resize).observe(el); resize();

    const draw = (t: number) => {
      const W = cv.width, H = cv.height, u = W / 900;
      const g = ctx.createLinearGradient(0, 0, W, H);
      g.addColorStop(0, '#0e1b33'); g.addColorStop(1, '#13253f');
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'rgba(255,255,255,.035)';
      for (let i = 0; i < 6; i++) ctx.fillRect(((i * 0.19 + t * 0.00002 * (i + 1)) % 1) * W, H * 0.55, W * 0.08, H * 0.45);
      const boxes: Box[] = real.get(cam) ?? sim.map((b) => {
        b.x += b.vx * 16; b.y += b.vy * 16;
        if (b.x < 0.05 || b.x > 0.8) b.vx *= -1;
        if (b.y < 0.2 || b.y > 0.6) b.vy *= -1;
        return b;
      });
      for (const b of boxes) {
        const x = b.x * W, y = b.y * H, w = b.w * W, h = b.h * H;
        const col = b.label === 'Arma de fuego' || b.label === 'Cuchillo' ? '#ff5d6c' : '#ffb454';
        ctx.strokeStyle = col; ctx.lineWidth = 2 * u; ctx.beginPath(); ctx.roundRect(x, y, w, h, 6 * u); ctx.stroke();
        const txt = `${b.label} ${Math.round(b.conf * 100)}%`;
        ctx.font = `700 ${13 * u}px Manrope, sans-serif`;
        const tw = ctx.measureText(txt).width + 14 * u;
        ctx.fillStyle = col; ctx.beginPath(); ctx.roundRect(x, y - 24 * u, tw, 22 * u, 6 * u); ctx.fill();
        ctx.fillStyle = '#1a0a0c'; ctx.fillText(txt, x + 7 * u, y - 8 * u);
      }
      requestAnimationFrame(draw);
    };
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(draw); else draw(0);
  });
</script>
